#!/usr/bin/env bash
# sudsy: squeaky-clean secrets for any project, on top of sops + age.
# https://github.com/monotropiclabs/sudsy (MIT)
#
# Written for bash 3.2+ so it runs on macOS's stock bash.
set -euo pipefail

VERSION="0.1.0"
CONFIG=".sops.yaml"
GLOBAL_KEY="${XDG_CONFIG_HOME:-$HOME/.config}/sops/age/keys.txt"

usage() {
  cat <<'EOF'
  o   °  O   °
 ╭───────────╮
 │   sudsy   │  squeaky-clean secrets, powered by sops + age
 ╰───────────╯

Usage: sudsy <command> [args]

  init                   find or create your age key and add it to ./.sops.yaml
  key                    print your public key (send it to whoever onboards you)
  edit <env>             edit <env>.enc.env in $SOPS_EDITOR/$EDITOR (creates it if new)
  run <env> -- cmd...    run cmd with <env>'s secrets in its environment
  cat <env>              print the decrypted dotenv
  json <env>             print the decrypted secrets as a JSON object
  get <env> <KEY>        print a single value
  sync [--yes]           re-encrypt every vault for the recipients in .sops.yaml,
                         showing each change in readers first (--yes skips the review)
  revoke [--yes] <pubkey>
                         remove a key everywhere, re-encrypt with new data keys, and
                         list the secrets it could read (rotate those at the source)
  ls                     list this project's environments
  version                print the sudsy version

Your private key is read from $SOPS_AGE_KEY_FILE, else the output of
$SOPS_AGE_KEY_CMD (e.g. your password manager), else ./secret.txt,
else ~/.config/sops/age/keys.txt (one key for all your projects).
In CI, set SOPS_AGE_KEY to the key's contents instead.
EOF
}

die() { echo "sudsy: $*" >&2; exit 1; }
say() { echo "🫧 $*"; }

need() {
  command -v "$1" >/dev/null 2>&1 || die "$1 not found. Install it first (macOS: brew install sops age)"
}

# $SOPS_AGE_KEY_CMD prints the private key, so it never has to sit in a file. An explicit
# $SOPS_AGE_KEY_FILE still wins.
use_key_cmd() { [ -z "${SOPS_AGE_KEY_FILE:-}" ] && [ -n "${SOPS_AGE_KEY_CMD:-}" ]; }

key_file() {
  if [ -n "${SOPS_AGE_KEY_FILE:-}" ]; then echo "$SOPS_AGE_KEY_FILE"
  elif [ -f secret.txt ]; then echo "secret.txt"
  else echo "$GLOBAL_KEY"; fi
}

# Run sops with our key. SOPS_AGE_KEY_FILE is only exported when the file exists: pointing
# sops at a missing file makes it fail even when SOPS_AGE_KEY (CI) holds a valid key.
s() {
  need sops
  local key; key="$(key_file)"
  if use_key_cmd; then env -u SOPS_AGE_KEY_FILE sops "$@"
  elif [ -f "$key" ]; then SOPS_AGE_KEY_FILE="$key" sops "$@"
  else
    if [ -z "${SOPS_AGE_KEY:-}" ] && [ -z "${SOPS_AGE_KEY_CMD:-}" ]; then
      die "no age key found at $key (run: sudsy init, or set SOPS_AGE_KEY)"
    fi
    env -u SOPS_AGE_KEY_FILE sops "$@"
  fi
}

# Split $1 into KEY_CMD_WORDS exactly as sops splits $SOPS_AGE_KEY_CMD (Go's shlex): blanks
# separate words, '...' is literal, a backslash makes the next character literal both bare
# and inside "...", and # at the start of a word comments out the rest of the line. Nothing
# is expanded and no shell is involved. Fails on an unterminated quote or a trailing \.
split_words() {
  local s="$1" i=0 n=${#1} c word="" inword=0 q="" sq="'" dq='"' bs='\'
  KEY_CMD_WORDS=()
  while [ "$i" -lt "$n" ]; do
    c="${s:$i:1}"; i=$((i + 1))
    if [ "$q" = "$sq" ]; then
      if [ "$c" = "$sq" ]; then q=""; else word="$word$c"; fi
    elif [ "$q" = "$dq" ] || [ "$c" = "$bs" ]; then
      if [ "$c" = "$bs" ]; then
        [ "$i" -lt "$n" ] || return 1
        word="$word${s:$i:1}"; i=$((i + 1)); inword=1
      elif [ "$c" = "$dq" ]; then q=""
      else word="$word$c"; fi
    else
      case "$c" in
        ' '|$'\t'|$'\n'|$'\r')
          if [ "$inword" = 1 ]; then KEY_CMD_WORDS+=("$word"); word=""; inword=0; fi ;;
        "$sq"|"$dq") q="$c"; inword=1 ;;
        '#')
          if [ "$inword" = 1 ]; then word="$word$c"
          else while [ "$i" -lt "$n" ] && [ "${s:$i:1}" != $'\n' ]; do i=$((i + 1)); done; fi ;;
        *) word="$word$c"; inword=1 ;;
      esac
    fi
  done
  [ -z "$q" ] || return 1
  if [ "$inword" = 1 ]; then KEY_CMD_WORDS+=("$word"); fi
  return 0
}

# Print the public key(s) for your private key. The command is split into words the way sops
# splits it (quotes respected, no shell, so no pipes), so whatever works here works for sops.
public_keys() {
  need age-keygen
  if use_key_cmd; then
    split_words "$SOPS_AGE_KEY_CMD" && [ "${#KEY_CMD_WORDS[@]}" -gt 0 ] \
      || die "\$SOPS_AGE_KEY_CMD is not a command sops can run (check its quotes)"
    "${KEY_CMD_WORDS[@]}" | age-keygen -y \
      || die "\$SOPS_AGE_KEY_CMD did not print an age private key"
  else
    local key; key="$(key_file)"
    [ -f "$key" ] || die "no age key at $key (run: sudsy init)"
    age-keygen -y "$key"
  fi
}

# <env>, <env>.enc.env and path/to/<env>.enc.env all mean ./<env>.enc.env
vault_name() {
  [ -n "${1:-}" ] || die "missing <env> (try: sudsy ls)"
  echo "$(basename "$1" .enc.env).enc.env"
}

existing_vault() {
  local f; f="$(vault_name "${1:-}")"
  [ -f "$f" ] || die "no $f here (try: sudsy ls)"
  echo "$f"
}

# POSIX single-quote every argument, so sops exec-env's `sh -c` sees them exactly as given.
shquote() {
  # Pattern and replacement live in variables: quote handling inside ${//} differs
  # between bash 3.2 and 5.
  local out="" arg sq="'" q="'\\''"
  for arg in "$@"; do out="$out'${arg//$sq/$q}' "; done
  echo "$out"
}

cmd_init() {
  need age-keygen
  local key=""
  if use_key_cmd; then
    say "Using the key from \$SOPS_AGE_KEY_CMD"
  elif key="$(key_file)" && [ -f "$key" ]; then
    say "Using your existing key: $key"
  else
    mkdir -p "$(dirname "$key")"
    (umask 077 && age-keygen -o "$key" 2>/dev/null)
    say "Created a new key: $key"
  fi

  # A keys file can hold several identities: use the first, but accept any of them.
  local pubs pub p
  pubs="$(public_keys)"
  pub="$(echo "$pubs" | head -n 1)"
  echo "   Public key: $pub"

  if [ ! -f "$CONFIG" ]; then
    printf 'creation_rules:\n  - path_regex: \\.enc\\.\n    age: >-\n      %s\n' "$pub" > "$CONFIG"
    say "Created $CONFIG with your key. Lather up: sudsy edit dev"
  else
    for p in $pubs; do
      if grep -qF "$p" "$CONFIG"; then say "Your key is already in $CONFIG. Squeaky clean."; return 0; fi
    done
    grep -q 'age1' "$CONFIG" || die "no age recipients in $CONFIG; add $pub to it by hand"
    # Append after the last age1 recipient, matching its indent.
    local last tmp
    last="$(grep -n 'age1' "$CONFIG" | tail -n 1 | cut -d: -f1)"
    tmp="$(mktemp)"
    awk -v n="$last" -v k="$pub" '
      NR == n { match($0, /^[ \t]*/); ind = substr($0, 1, RLENGTH); sub(/,?[ \t]*$/, ","); print; print ind k; next }
      { print }' "$CONFIG" > "$tmp"
    cat "$tmp" > "$CONFIG" && rm -f "$tmp"
    say "Added your key to $CONFIG."
    echo "   Commit it, then ask someone who already has access to run: sudsy sync"
  fi

  # Ask git rather than look for a .git dir: in a worktree or a subdirectory .git is a file or
  # not there at all, and check-ignore also sees patterns and excludes beyond ./.gitignore.
  if [ "$key" = "secret.txt" ] && command -v git >/dev/null 2>&1 \
    && git rev-parse --is-inside-work-tree >/dev/null 2>&1 && ! git check-ignore -q secret.txt; then
    echo "secret.txt" >> .gitignore
    say "Added secret.txt to .gitignore."
  fi
}

cmd_key() { public_keys; }

cmd_edit() {
  local f; f="$(vault_name "${1:-}")"
  [ -f "$CONFIG" ] || die "no $CONFIG here (run: sudsy init)"
  local rc=0
  SOPS_EDITOR="${SOPS_EDITOR:-${EDITOR:-nano}}" s "$f" || rc=$?
  # sops exits 200 when nothing changed; that's not an error.
  if [ "$rc" -eq 200 ]; then say "No changes to $f."; return 0; fi
  return "$rc"
}

cmd_run() {
  local f; f="$(existing_vault "${1:-}")"; shift
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "usage: sudsy run <env> -- cmd..."
  s exec-env --same-process "$f" "exec $(shquote "$@")"
}

cmd_get() {
  local f; f="$(existing_vault "${1:-}")"
  local k="${2:-}"
  [ -n "$k" ] || die "usage: sudsy get <env> <KEY>"
  case "$k" in *[!A-Za-z0-9_.-]*) die "invalid key name: $k" ;; esac
  local v; v="$(s -d --extract "[\"$k\"]" "$f")" || die "$k not found in $f"
  printf '%s\n' "$v"
}

cmd_cat() {
  local f; f="$(existing_vault "${1:-}")"; shift
  s -d "$@" "$f"
}

# sync decides who can read every vault, and anyone who can push can add a key to .sops.yaml.
# So sops shows each change in readers and asks first; only --yes skips that review, and with
# no terminal to ask at, sync refuses rather than widen access unattended.
need_review_or_yes() {
  if [ -z "$1" ] && [ ! -t 0 ]; then
    die "this changes who can read your vaults. Run it at a terminal to review each change, or pass --yes"
  fi
}

cmd_sync() {
  local yes=""
  case "${1:-}" in
    "") ;;
    -y|--yes) yes=1 ;;
    *) die "usage: sudsy sync [--yes]" ;;
  esac
  need_review_or_yes "$yes"
  update_vaults "$yes"
}

update_vaults() {
  local yes="$1" f found=""
  for f in *.enc.*; do
    [ -f "$f" ] || continue
    found=1
    say "Rinsing $f..."
    if [ -n "$yes" ]; then s updatekeys -y "$f"; else s updatekeys "$f"; fi
  done
  [ -n "$found" ] || die "no *.enc.* vaults here"
  if [ -n "$yes" ]; then say "All vaults match $CONFIG."
  else say "Done. Any vault you declined is left as it was."; fi
}

# Print $CONFIG without recipient $1: its own line in an "age: >-" list, or one entry in an
# inline "age: a,b" list. The line before a removed last entry loses its trailing comma.
config_without() {
  awk -v k="$1" '
    { t = $0; gsub(/^[ \t]+|[ \t,]+$/, "", t); if (t == k) next
      if (index($0, k)) { gsub("," k, ""); gsub(k ",?", "") }
      out[++n] = $0 }
    END { for (i = 1; i <= n; i++) {
      l = out[i]
      if (l ~ /^[ \t]*age1[0-9a-z]+,[ \t]*$/ && (i == n || out[i + 1] !~ /^[ \t]*age1/)) sub(/,[ \t]*$/, "", l)
      print l } }' "$CONFIG"
}

# One line per creation rule that has age recipients: "<rule number> <recipient count>".
age_counts() {
  uncommented "$1" | awk '/^[ \t]*-[ \t]/ { r++ } r { c[r] += gsub(/age1[0-9a-z]+/, "&") } END { for (i = 1; i <= r; i++) if (c[i]) print i, c[i] }'
}

# $1 without YAML comments, so a commented-out key never counts as a reader.
uncommented() {
  sed 's/#.*//' "$1"
}

# The public key of every identity sops will use: the key file, SOPS_AGE_KEY, SOPS_AGE_KEY_CMD.
own_keys() {
  local f; f="$(key_file)"
  if [ -f "$f" ]; then age-keygen -y "$f" 2>/dev/null; fi
  if [ -n "${SOPS_AGE_KEY:-}" ]; then printf '%s\n' "$SOPS_AGE_KEY" | age-keygen -y 2>/dev/null; fi
  if [ -n "${SOPS_AGE_KEY_CMD:-}" ]; then sh -c "$SOPS_AGE_KEY_CMD" 2>/dev/null | age-keygen -y 2>/dev/null; fi
  return 0
}

cmd_revoke() {
  local yes="" k="" a tmp f names had="" kept="" r before after
  for a in "$@"; do
    case "$a" in
      -y|--yes) yes=1 ;;
      *) [ -z "$k" ] || die "usage: sudsy revoke [--yes] <pubkey>"; k="$a" ;;
    esac
  done
  [ -n "$k" ] || die "usage: sudsy revoke [--yes] <pubkey>"
  # Spelled out: in some locales a range like a-z also matches capitals.
  case "$k" in age1*) ;; *) die "not an age public key: $k" ;; esac
  case "${k#age1}" in ""|*[!0123456789abcdefghijklmnopqrstuvwxyz]*) die "not an age public key: $k" ;; esac
  [ -f "$CONFIG" ] || die "no $CONFIG here"
  # Re-encrypting without your own key would leave you unable to rotate the vaults.
  if own_keys | grep -qxF "$k"; then
    die "$k is your own key; ask someone else who can read the vaults to revoke it"
  fi
  # sops keeps each vault's recipients in the clear, so grep tells which ones $k can read.
  for f in *.enc.*; do
    if [ -f "$f" ] && grep -qF "$k" "$f"; then had="$had $f"; fi
  done
  if uncommented "$CONFIG" | grep -qF "$k"; then
    need_review_or_yes "$yes"
    tmp="$(mktemp)"
    config_without "$k" > "$tmp"
    # Every rule that had age readers must keep at least one, or sops could not encrypt for it.
    while read -r r before; do
      after="$(age_counts "$tmp" | awk -v r="$r" '$1 == r { print $2 }')"
      [ -n "$after" ] || { rm -f "$tmp"; die "revoking $k would leave rule $r in $CONFIG with no readers; add another key first"; }
    done < <(age_counts "$CONFIG")
    cat "$tmp" > "$CONFIG" && rm -f "$tmp"
    say "Removed $k from $CONFIG."
  elif [ -n "$had" ]; then
    # An earlier revoke was declined for some vaults: finish it, new data keys included.
    need_review_or_yes "$yes"
    say "$k is already gone from $CONFIG; finishing the revoke for:$had"
  else
    die "$k is not in $CONFIG"
  fi

  update_vaults "$yes"
  [ -n "$had" ] || { say "No vault was readable with $k, so there is nothing to rotate."; return 0; }
  for f in $had; do
    if grep -qF "$k" "$f"; then kept="$kept $f"; continue; fi
    # updatekeys re-wraps the old data key; rotate makes a new one, so a copy of the old
    # data key no longer opens the vault.
    s rotate -i "$f"
    say "$f has a new data key."
  done

  echo
  say "$k could read these. Rotate each one at its source (a new API key, a new password):"
  for f in $had; do
    case "$f" in
      *.enc.env) names="$(s -d "$f" | sed -n 's/^\([^#=][^=]*\)=.*/\1/p' | tr '\n' ' ')"
                 echo "   $f: ${names:-(empty)}" ;;
      *) echo "   $f: everything in it" ;;
    esac
  done
  echo "   Old versions stay readable in git history, which is why the values themselves must change."
  [ -z "$kept" ] || die "still readable with $k:$kept (you declined the update). To finish, run: sudsy revoke $k"
}

cmd_ls() {
  local f
  for f in *.enc.env; do [ -f "$f" ] && echo "${f%.enc.env}"; done
  return 0
}

sub="${1:-help}"
[ $# -gt 0 ] && shift
case "$sub" in
  init) cmd_init ;;
  key) cmd_key ;;
  edit) cmd_edit "$@" ;;
  run) [ $# -gt 0 ] || die "usage: sudsy run <env> -- cmd..."; cmd_run "$@" ;;
  cat) cmd_cat "${1:-}" ;;
  json) cmd_cat "${1:-}" --output-type json ;;
  get) cmd_get "$@" ;;
  sync) cmd_sync "$@" ;;
  revoke) cmd_revoke "$@" ;;
  ls) cmd_ls ;;
  version|-v|--version) echo "sudsy $VERSION" ;;
  help|-h|--help) usage ;;
  *) die "unknown command: $sub (try: sudsy help)" ;;
esac
